# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# --- local tooling / caches ---
.claude/
data_cache/
.cache/
models/
runs/

# --- experiment data: results, trained agents and the oracle archives live in the HF
# --- dataset toms55/IntelligentDispatchExperiments (see README.md). `hf download`
# --- restores them here. ---
results/*
!results/.gitkeep
trainedPolicies/*
!trainedPolicies/.gitkeep
oracleResults/*
!oracleResults/.gitkeep

# --- CLI outputs now land in results/cli/, which results/* already covers. These
# --- two patterns stay as a safety net for an older invocation run from the root. ---
lp_*.csv
*.png

# --- papers, drafts, forms: copyright / PII, never commit ---
*.pdf
*.doc
*.docx
*.odt
*.xls
*.xlsx
*.zip
*.o*

# --- local helper and PBS job logs ---
/id
id-*.o[0-9]*

# ad hoc price exports
/forecast_*.csv
/real_prices_*.csv

