# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# --- local tooling / caches ---
.claude/
data_cache/
model/
runs/

# --- the published agents: binary weights, moved between machines with rsync ---
trainedPolicies/

# --- experiment outputs: only the published runs (one CSV) and their actions exports
# --- (one Parquet) per run per region. The live actions CSV a backtest appends to stays out ---
results/**
!results/actions/
!results/actions/*.parquet
!results/backtestResults/
!results/backtestResults/*.csv

# --- CLI outputs: <module>_<region>_<date>.csv/.png land in the cwd ---
lp_*.csv
*png

# --- papers, drafts, forms: copyright / PII, never commit ---
*.pdf
*.doc
*.docx
*.odt
*.xls
*.xlsx
*.zip

# --- local helper and PBS job logs ---
/id
id-*.o[0-9]*

