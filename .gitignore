# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# --- local tooling / caches ---
.claude/
data_cache/
model/
runs/

# --- experiment data: results, trained agents and the oracle archives live in the HF
# --- dataset toms55/IntelligentDispatchExperiments (see README.md). `hf download`
# --- restores them here. ---
results/*
!results/.gitkeep
trainedPolicies/*
!trainedPolicies/.gitkeep
oracleResults/*
!oracleResults/.gitkeep

# --- CLI outputs: <module>_<region>_<date>.csv/.png land in the cwd ---
lp_*.csv
*png

